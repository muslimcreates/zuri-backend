# Copy this file to .env and fill in real values.

# Local Postgres connection string. Update user/password/db name to match
# whatever you set up locally (see README for install instructions).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zuri_express?schema=public"

# Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

PORT=4000
NODE_ENV=development

# The URL of your frontend dev server, for CORS (credentials: true requires
# an exact origin, not a wildcard). Update when you build the React app.
CLIENT_ORIGIN="http://localhost:5173"

# --- Payment gateway (not wired up yet) ---
# No registered Turkish company yet, so no live payment gateway. Orders use
# manual payment methods (bank transfer / cash on delivery) for now. Once a
# company + business bank account exist, add iyzico or PayTR keys here and
# see src/lib/payments.ts for where to plug in the real integration.
# IYZICO_API_KEY=
# IYZICO_SECRET_KEY=
