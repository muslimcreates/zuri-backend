# Copy this file to .env and fill in real values.

# Postgres connection string. Using Supabase (recommended, see README): copy
# the "Session pooler" connection string from your project's Connect dialog
# and paste it here, replacing [YOUR-PASSWORD] with your actual DB password.
# Using local Postgres instead: postgresql://postgres:postgres@localhost:5432/zuri_express?schema=public
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

PORT=4000
NODE_ENV=development

# The URL of your frontend dev server, for CORS (credentials: true requires
# an exact origin, not a wildcard). Update when you build the React app.
CLIENT_ORIGIN="http://localhost:5173"

# --- Google Sign-In ---
# The "Client ID" from a Google Cloud OAuth 2.0 Client ID (Web application
# type). See README "Setting up Google Sign-In" for how to create one. Only
# the Client ID is needed on the backend (it's used to verify tokens); there
# is no client secret to configure for this flow.
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"

# --- Email verification (Resend) ---
# See README "Setting up email verification" for how to get these. If you
# leave RESEND_API_KEY unset, signup still works — the verification link is
# printed to the server console instead of emailed, which is fine for local
# development.
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# EMAIL_FROM="Zuri Express <noreply@yourdomain.com>"

# --- Payment gateway (not wired up yet) ---
# No registered Turkish company yet, so no live payment gateway. Orders use
# manual payment methods (bank transfer / cash on delivery) for now. Once a
# company + business bank account exist, add iyzico or PayTR keys here and
# see src/lib/payments.ts for where to plug in the real integration.
# IYZICO_API_KEY=
# IYZICO_SECRET_KEY=
