// Zuri Express — database schema
// Single admin-managed store (not a multi-vendor marketplace).
// Fulfillment is hybrid: some products are stocked locally in Turkey (STOCKED),
// others are imported per order from Kenya (ON_REQUEST) with an estimated lead time.
// No live payment gateway yet (no registered Turkish company) — orders are placed
// with a manual payment method (bank transfer / cash on delivery) and the admin
// marks payment received by hand. See src/lib/payments.ts for how to wire in
// iyzico/PayTR later without changing this schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum FulfillmentType {
  STOCKED // held locally in Turkey, backed by `stock`
  ON_REQUEST // imported per order from Kenya, backed by `leadTimeDays`
}

enum PaymentMethod {
  BANK_TRANSFER
  MPESA
  // No longer offered at checkout (see lib/payments.ts's
  // MANUAL_PAYMENT_METHODS) — kept in the enum only so existing orders that
  // were placed with this method keep their recorded value.
  CASH_ON_DELIVERY
}

enum OrderStatus {
  PENDING_PAYMENT // order placed, awaiting manual payment confirmation
  PAYMENT_RECEIVED // admin confirmed payment
  PROCESSING // being packed / sourced
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  // Null for accounts created via Google Sign-In that have never set a
  // password. Every route that checks a password must handle null (see
  // src/routes/auth.ts).
  passwordHash String?
  // Google's stable per-account id ("sub" claim), set once a user signs in
  // with Google — either at signup, or linked onto an existing
  // email/password account that shares the same email.
  googleId  String?  @unique
  avatarUrl String?

  // Email verification. Google accounts are considered verified
  // automatically (Google already confirmed the address). Email/password
  // accounts start false. Every verification email carries both a link
  // (emailVerificationTokenHash — long, unguessable, looked up globally by
  // GET /api/auth/verify-email) and a short code (emailVerificationCodeHash
  // — typed in on the verify-email page, checked only against the caller's
  // own account via POST /api/auth/verify-email-code, so a 6-digit code is
  // not brute-forceable the way a global lookup would make it). Both share
  // one expiry and are cleared together once either one succeeds. Required
  // to use the cart or check out — see README "Email verification".
  emailVerified              Boolean   @default(false)
  emailVerificationTokenHash String?   @unique
  emailVerificationCodeHash  String?
  emailVerificationExpires   DateTime?

  // Promotional/marketing emails ("new arrivals", sales, etc.) — distinct
  // from the transactional emails above (verification, order confirmation),
  // which always go out regardless of this flag. Set true the moment
  // someone agrees to the Terms & Conditions at signup (see
  // SignupSchema.agreeToTerms in routes/auth.ts), which is where consent to
  // receive these is captured. Mirrored into a Resend Audience (see
  // src/lib/marketing.ts) — actually *sending* a promotional email is done
  // from Resend's own dashboard (Broadcasts), not from this codebase, so
  // there's no in-app "send announcement" feature to build or maintain.
  marketingOptIn Boolean @default(false)

  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())

  addresses Address[]
  orders    Order[]
  cart      Cart?
}

model Address {
  id          String  @id @default(cuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String
  phone       String
  city        String
  addressLine String
  postalCode  String

  // The row a user manages from /settings — kept editable, and completely
  // separate from every other Address row here, which are one-per-order
  // *snapshots* created inside createOrder() (see lib/orders.ts). That
  // separation matters: an Order's delivery address must never silently
  // change after the fact just because someone updated their saved address
  // later, the same way OrderItem snapshots product name/price. At most one
  // row per user should have isDefault true — enforced in application code
  // (routes/addresses.ts), not a DB constraint, since Postgres has no
  // built-in "unique where true" short of a partial index we'd rather not
  // introduce for one boolean.
  isDefault Boolean @default(false)

  orders Order[]

  @@index([userId])
}

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  products Product[]
}

model Product {
  id              String          @id @default(cuid())
  name            String
  slug            String          @unique
  description     String
  imageUrl        String
  priceKurus      Int // price in Turkish kuruş (1 TRY = 100 kurus) to avoid float rounding
  fulfillmentType FulfillmentType
  stock           Int? // set for STOCKED products; null for ON_REQUEST
  leadTimeDays    Int? // set for ON_REQUEST products; null for STOCKED
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  orderItems OrderItem[]
  cartItems  CartItem[]

  @@index([categoryId])
}

// One cart per user, created lazily on first add-to-cart. Replaces the old
// design where the frontend kept cart state in localStorage — that meant
// carts didn't survive a new device/browser, and (until fixed) could even
// leak between users sharing one browser. Server-side means a user's cart
// now follows their account everywhere, which checkout (see routes/orders.ts)
// also relies on: it reads the cart directly rather than trusting a
// client-sent item list.
model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([cartId])
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  addressId     String
  address       Address       @relation(fields: [addressId], references: [id])
  status        OrderStatus   @default(PENDING_PAYMENT)
  paymentMethod PaymentMethod
  paymentNote   String? // admin notes, e.g. bank transfer reference
  subtotalKurus Int
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items OrderItem[]

  @@index([userId])
}

model OrderItem {
  id              String          @id @default(cuid())
  orderId         String
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product         @relation(fields: [productId], references: [id])
  // Snapshots at time of order, so later product edits never change past orders
  productName     String
  unitPriceKurus  Int
  quantity        Int
  fulfillmentType FulfillmentType
  lineTotalKurus  Int

  @@index([orderId])
}
